# Salin file ini menjadi .env lalu ubah sesuai kebutuhan.
# Semua nilai bersifat opsional; jika kosong, default di core/config.py dipakai.

# Path model (default: model/slerp_model dan model/lora_model di folder proyek)
# BASE_MODEL_PATH=D:\indo-math-reasoning-slm\model\slerp_model
# ADAPTER_MODEL_PATH=D:\indo-math-reasoning-slm\model\lora_model

# Model full slerp-sft hasil `python -m utils.merge_lora` (dipakai jika ada)
# MERGED_MODEL_PATH=D:\indo-math-reasoning-slm\model\slerp_sft_model
USE_MERGED_MODEL=true

MODEL_DISPLAY_NAME=slerp-sft-model
# Wajib GPU: server tidak mau start tanpa CUDA
REQUIRE_GPU=true
GPU_INDEX=0
# Hanya untuk debugging
FORCE_CPU=false

MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9
DO_SAMPLE=true

HOST=0.0.0.0
PORT=8000
