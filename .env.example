# Copy to .env to override the defaults in core/config.py. Every value is optional.

# Model files (relative to the project folder unless absolute).
# MERGED_MODEL_PATH=model/slerp_sft_model
# BASE_MODEL_PATH=model/slerp_model
# ADAPTER_MODEL_PATH=model/lora_model
# Set to false to load the SLERP model plus LoRA adapter instead of the merged model.
USE_MERGED_MODEL=true
MODEL_DISPLAY_NAME=slerp-sft-model

# Hardware. With REQUIRE_GPU=true the server will not start without CUDA.
REQUIRE_GPU=true
GPU_INDEX=0
# Debugging only: run on the CPU even when a GPU is present.
FORCE_CPU=false

# Generation. Sampling gives more varied solutions. Set DO_SAMPLE=false for
# greedy decoding, which reproduces the evaluation results.
MAX_NEW_TOKENS=1024
DO_SAMPLE=true
# Only used when DO_SAMPLE=true.
TEMPERATURE=0.7
TOP_P=0.9

# Server address for `python main.py`.
HOST=0.0.0.0
PORT=8000
